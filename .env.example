# 复制本文件为 .env，然后填入自己的密钥：
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env 已被 .gitignore 排除，不会被提交；也可以改用系统环境变量，优先级更高。

# ---- 文本模型（小说分析 / 人设 / 分镜拆解）----
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- 图像模型（本地 ComfyUI）----
# ComfyUI 默认 http://127.0.0.1:8188 不带鉴权，留空即可；
# 只有给 ComfyUI 套了反向代理鉴权时才需要填写。
COMFY_API_KEY=
